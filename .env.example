PORT=4000
NODE_ENV=development

DATABASE_URL="postgresql://user:password@localhost:5432/ems_db"

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change_this_secret node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_DAYS=7

FORCE_HTTPS=false

CHIRPSTACK_MIDDLEWARE_URL=http://192.168.100.204:3001
CHIRPSTACK_APPLICATION_ID=4360bdb1-6cdd-4d38-b92a-ea6020ebbea0
CHIRPSTACK_DEVICE_PROFILE_ID=eca3da95-323f-48b3-a92f-5a3ab618a56a

ENERGY_RETENTION_DAYS=90

# Comma-separated, contoh: https://ems.falahtech.co.id,https://ems-staging.falahtech.co.id
# Kalau dikosongin, CORS mengizinkan semua origin)
ALLOWED_ORIGINS=https://ems.example.com

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_POWER_MAX=20
RATE_LIMIT_ME_MAX=60

TURNSTILE_SECRET_KEY=0x4AAAAAAEneruH49-DgB0BZ30Pds1EhBDo

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15