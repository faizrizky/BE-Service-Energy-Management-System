generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

 model User {
   id          String       @id @default(uuid())
   fullName    String
   username    String       @unique
   email       String       @unique
   passwordHash String
   phone       String?
   address     String?
   avatarUrl   String?
   roleId      String
   role        Role         @relation(fields: [roleId], references: [id])
   lastActiveAt DateTime?
   failedLoginCount Int @default(0)
   lockedUntil DateTime?
   schedules   Schedule[]
   commandLogs CommandLog[]
   installedGateways Gateway[]
   refreshTokens RefreshToken[]
   createdAt   DateTime     @default(now())
   updatedAt   DateTime     @updatedAt

   @@map("users")
 }

model RefreshToken{
  id String @id @default(uuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id     String           @id @default(uuid())
  module String
  action String
  roles  RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Room {
  id          String       @id @default(uuid())
  name        String
  picName     String?
  picPhone    String?
  location    String?
  description String?
  imageUrl    String?
  isCritical  Boolean      @default(false)
  devices     Device[]
  schedules   Schedule[]
  commandLogs CommandLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("rooms")
}

 model Gateway {
   id               String    @id @default(uuid())
   eui              String    @unique
   name             String
   description      String?
   simcard          String?
   powerSource      String?
   modelUnit        String?
   installationDate DateTime?
   status           String    @default("offline")
   lastSeenAt       DateTime?
   installedById    String?
   installedBy      User?     @relation(fields: [installedById], references: [id])
   devices          Device[]
   createdAt        DateTime  @default(now())
   updatedAt        DateTime  @updatedAt

   @@map("gateways")
 }

model Device {
  id              String          @id @default(uuid())
  eui             String          @unique
  tbDeviceId      String?         @unique
  roomId          String
  gatewayId       String
  name            String
  deviceType      String?
  intervalMinutes Int             @default(5)
  status          String          @default("off")
  lastSeenAt      DateTime?
  room            Room            @relation(fields: [roomId], references: [id])
  gateway         Gateway         @relation(fields: [gatewayId], references: [id])
  readings        EnergyReading[]
  schedules       Schedule[]
  commandLogs     CommandLog[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("devices")
}

model EnergyReading {
  id         BigInt   @id @default(autoincrement())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id])
  powerWatt  Float?
  usageKwh   Float?
  recordedAt DateTime @default(now())

  @@index([deviceId, recordedAt])
  @@map("energy_readings")
}

model Schedule {
  id            String       @id @default(uuid())
  roomId        String
  deviceId      String?
  action        String
  scheduledDate DateTime
  startTime     String
  endTime       String?
  repeatType    String       @default("none")
  repeatDays    Json?
  status        String       @default("active")
  createdById   String
  room          Room         @relation(fields: [roomId], references: [id])
  device        Device?      @relation(fields: [deviceId], references: [id])
  createdBy     User         @relation(fields: [createdById], references: [id])
  commandLogs   CommandLog[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("schedules")
}

model CommandLog {
  id                String    @id @default(uuid())
  roomId            String
  deviceId          String?
  action            String
  triggerType       String // "manual" | "scheduled"
  triggeredByUserId String? // null kalau triggerType = scheduled
  scheduleId        String? // null kalau triggerType = manual
  executedAt        DateTime  @default(now())
  status            String // "success" | "failed" | "gateway_offline"
  notes             String?
  room              Room      @relation(fields: [roomId], references: [id])
  device            Device?   @relation(fields: [deviceId], references: [id])
  triggeredBy       User?     @relation(fields: [triggeredByUserId], references: [id])
  schedule          Schedule? @relation(fields: [scheduleId], references: [id])

  @@map("command_logs")
}

model WebhookEvent {
  id           String   @id @default(uuid())
  source       String 
  eventId      String?  @unique
  tbDeviceId   String?
  payload      Json
  status       String // "received" | "processed" | "ignored_unknown_device" | "invalid_secret" | "error"
  errorMessage String?
  receivedAt   DateTime @default(now())

  @@index([tbDeviceId, receivedAt])
  @@map("webhook_events")
}

model SecurityEvent {
  id        String   @id @default(uuid())
  type      String   // "login_failed" | "login_locked" | "rbac_denied" | "rate_limited" | "invalid_refresh_token"
  username  String?
  userId    String?
  ip        String?
  userAgent String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@map("security_events")
}
